# Database configuration
POSTGRES_DB=safahawa
POSTGRES_USER=hawa
POSTGRES_PASSWORD=hawa
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Shared connection string
DATABASE_URL=postgresql+psycopg://hawa:hawa@postgres:5432/safahawa

# Upstream air quality API URL
# For offline demo, point to fake upstream: http://localhost:8555/v1/air-quality
UPSTREAM_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Poller settings
POLL_INTERVAL_MINUTES=15
LOOKBACK_HOURS=6
LOG_LEVEL=INFO

# Web & API Ports
API_PORT=8000
WEB_PORT=5173
API_BASE_URL=/api/v1
